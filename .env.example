# ─── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
OWNER_PHONE_NUMBER=+1XXXXXXXXXX
TAKEOVER_PHONE_NUMBER=+1XXXXXXXXXX

# ─── AI Services ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # only needed if LLM_PROVIDER=gemini
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LLM (the reasoning brain — priority chain) ───────────────────────────────
# Primary answers if its key is set; otherwise (or on failure) the fallback does.
# Set keys for both to get Claude-first-with-Gemini-fallback; set only one to use
# just that one. Blank LLM_FALLBACK_PROVIDER to disable fallback entirely.
LLM_PROVIDER=claude                # primary brain: claude | gemini
LLM_FALLBACK_PROVIDER=gemini       # fallback brain: gemini | claude | (blank = none)
LLM_MODEL=claude-haiku-4-5         # Claude model; claude-sonnet-5 for complex
GEMINI_MODEL=gemini-2.5-flash      # Gemini model — verify it matches your key's access
LLM_MAX_TOKENS=400                 # short spoken replies (shared by all providers)
LLM_TEMPERATURE=0.7                # shared by all providers
# LLM_SYSTEM_PROMPT is set in config.py (long default); override here if desired.

# ─── STT (Whisper primary, Deepgram optional) ─────────────────────────────────
STT_PROVIDER=whisper               # whisper | deepgram
STT_LANGUAGE=                      # blank = auto-detect (e.g. en, es, fr)
WHISPER_MODEL_SIZE=base            # tiny | base | small | medium | large
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8          # int8 (cpu) | float16 (gpu)
DEEPGRAM_MODEL=nova-2

# ─── TTS (Coqui XTTS-v2 via Docker) ───────────────────────────────────────────
COQUI_TTS_URL=http://localhost:8020
TTS_PROVIDER=coqui                 # coqui | gtts
TTS_DEFAULT_VOICE=voice_sample     # = your voice sample filename without extension
TTS_LANGUAGE=en
TTS_FALLBACK_ENABLED=true          # fall back to gTTS if Coqui is unavailable

# ─── Data ──────────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceai
REDIS_URL=redis://localhost:6379

# ─── Application ───────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8000
SEMANTIC_MATCH_THRESHOLD=0.75
ESCALATION_CONFIDENCE_THRESHOLD=0.50
MAX_CALL_TURNS=20

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Voice ─────────────────────────────────────────────────────────────────────
VOICE_SAMPLE_PATH=assets/voice_sample.wav
